<?xml version="1.0"?>
<robot name="hugr_optimus" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ================= MATERIALS ================= -->
  <material name="marine_orange">
    <color rgba="0.95 0.45 0.05 1.0"/>
  </material>

  <material name="dark_grey">
    <color rgba="0.2 0.22 0.25 1.0"/>
  </material>

  <material name="aluminum">
    <color rgba="0.65 0.7 0.75 1.0"/>
  </material>

  <material name="thruster_blue">
    <color rgba="0.05 0.2 0.7 1.0"/>
  </material>

  <material name="propeller_gold">
    <color rgba="0.85 0.7 0.2 1.0"/>
  </material>

  <!-- ================= BASE FOOTPRINT & BASE LINK ================= -->
  <!-- base_footprint is on the calm water surface (Z=0) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- base_link is located at the vessel Center of Gravity (CG) -->
  <link name="base_link">
    <!-- Authentic 3D CAD Mesh imported from OnShape STEP model (Ferdig assembly.step) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="package://hugr_description/meshes/frame.stl" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="aluminum"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <box size="1.00 0.69 0.54"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="28.0"/>
      <!-- Vessel inertia (kg*m^2) based on CAD physical mass properties -->
      <inertia ixx="1.8" ixy="0.0" ixz="0.0" iyy="4.5" iyz="0.0" izz="5.2"/>
    </inertial>
  </link>

  <!-- ================= 4-THRUSTER PROPULSION CONFIGURATION ================= -->
  <!-- Matches ESP32 micro-ROS /motor_pwms topic: [M1: Port, M2: Starboard, M3: Bow Transverse, M4: Stern Transverse] -->
  <!-- Positioned exactly at BlueRobotics T200 thruster mount coordinates extracted from CAD STEP model -->

  <!-- MOTOR 1: Port Main Longitudinal Thruster (T_200_202, +Y Side, Pushes Surge +X) -->
  <link name="port_main_thruster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.048" length="0.10"/>
      </geometry>
      <material name="thruster_blue"/>
    </visual>
    <visual>
      <origin xyz="-0.05 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="propeller_gold"/>
    </visual>
  </link>

  <joint name="port_main_thruster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="port_main_thruster_link"/>
    <origin xyz="-0.2323 0.1518 -0.3379" rpy="0 0 0"/>
  </joint>

  <!-- MOTOR 2: Starboard Main Longitudinal Thruster (T_200, -Y Side, Pushes Surge +X) -->
  <link name="starboard_main_thruster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.048" length="0.10"/>
      </geometry>
      <material name="thruster_blue"/>
    </visual>
    <visual>
      <origin xyz="-0.05 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="propeller_gold"/>
    </visual>
  </link>

  <joint name="starboard_main_thruster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="starboard_main_thruster_link"/>
    <origin xyz="-0.2323 -0.1518 -0.3379" rpy="0 0 0"/>
  </joint>

  <!-- MOTOR 3: Bow Transverse Tunnel Thruster (T_200_203, Front Center, Pushes Sway +/-Y) -->
  <link name="bow_transverse_thruster_link">
    <visual>
      <!-- Transverse Tunnel oriented along Y-axis -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.048" length="0.10"/>
      </geometry>
      <material name="thruster_blue"/>
    </visual>
    <visual>
      <!-- Central Impeller Hub -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="propeller_gold"/>
    </visual>
  </link>

  <joint name="bow_transverse_thruster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bow_transverse_thruster_link"/>
    <origin xyz="0.2884 0.0 -0.2969" rpy="0 0 0"/>
  </joint>

  <!-- MOTOR 4: Stern Transverse Tunnel Thruster (T_201, Rear Center, Pushes Sway +/-Y) -->
  <link name="stern_transverse_thruster_link">
    <visual>
      <!-- Transverse Tunnel oriented along Y-axis -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.048" length="0.10"/>
      </geometry>
      <material name="thruster_blue"/>
    </visual>
    <visual>
      <!-- Central Impeller Hub -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="propeller_gold"/>
    </visual>
  </link>

  <joint name="stern_transverse_thruster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="stern_transverse_thruster_link"/>
    <origin xyz="-0.4066 0.0 -0.2969" rpy="0 0 0"/>
  </joint>

  <!-- ================= SENSORS: IMU & CAMERA ================= -->

  <!-- 1. IMU Frame (Xsens MTi-680G on vessel CG) -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.058 0.058 0.022"/>
      </geometry>
      <material name="marine_orange"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 -0.0184" rpy="0 0 0"/>
  </joint>

  <!-- 2. Front Luxonis OAK-D Camera Frame (CAD OKE-D Pro W) -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.12 0.03"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.4076 0.0 -0.0391" rpy="0 0.08 0"/>
  </joint>

  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

</robot>
