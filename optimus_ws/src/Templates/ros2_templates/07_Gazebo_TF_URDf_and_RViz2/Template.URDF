<?xml version="1.0"?>
<!-- The root element of any URDF file is always <robot> with a unique name attribute -->
<robot name="pedagogical_robot">

  <!-- ==================================================================== -->
  <!-- 1. THE ROOT LINK (base_link)                                         -->
  <!-- Best Practice: Always have a root link with no parent.               -->
  <!-- ==================================================================== -->
  <link name="base_link">
    <!-- Visual: What the user sees in Rviz or Gazebo -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" /> <!-- Local offset of visual geometry -->
      <geometry>
        <box size="0.5 0.3 0.2" />       <!-- Simple box: length(X), width(Y), height(Z) -->
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0" /> <!-- RGBA color format (0.0 to 1.0 range) -->
      </material>
    </visual>

    <!-- Collision: Used by physics engines for contacts and obstacles -->
    <!-- Pro-Tip: Keep collision shapes simpler than visual meshes for performance! -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.5 0.3 0.2" />
      </geometry>
    </collision>

    <!-- Inertial: Physical mass properties (Required for dynamic simulation) -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" /> <!-- Center of mass coordinates -->
      <mass value="5.0" />              <!-- Mass in kilograms (kg) -->
      <!-- Inertia Matrix (3x3): Measures resistance to rotational acceleration -->
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.12" iyz="0.0" izz="0.14" />
    </inertial>
  </link>

  <!-- ==================================================================== -->
  <!-- 2. THE JOINT (Connecting base_link to a Wheel)                        -->
  <!-- Rule: Joints represent the spatial offset and movement capability.   -->
  <!-- ==================================================================== -->
  <!-- This joint connects "base_link" (parent) to "left_wheel" (child) -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel" />
    
    <!-- Origin: Where is the joint relative to the PARENT link's origin? -->
    <!-- xyz: Shift +0.15m in X (forward), +0.18m in Y (left), -0.05m in Z (down) -->
    <!-- rpy: No initial rotation (0 0 0) -->
    <origin xyz="0.15 0.18 -0.05" rpy="0 0 0" />
    
    <!-- Axis: Around what local coordinate axis does the joint rotate? -->
    <!-- x y z = 0 1 0 means the joint rotates purely around the Y-axis (the pitch axis) -->
    <axis xyz="0 1 0" />
  </joint>

  <!-- ==================================================================== -->
  <!-- 3. THE CHILD LINK (left_wheel)                                       -->
  <!-- This link's origin (0,0,0) is located EXACTLY at the joint's origin.  -->
  <!-- ==================================================================== -->
  <link name="left_wheel">
    <visual>
      <!-- We rotate the visual cylinder by 90 deg (1.5708 rad) around X-axis -->
      <!-- to align the wheel faces facing outwards (towards Y-direction) -->
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" /> <!-- Cylinder: radius, length/thickness -->
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0" />
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.0013" ixy="0.0" ixz="0.0" iyy="0.0013" iyz="0.0" izz="0.0025" />
    </inertial>
  </link>

</robot>