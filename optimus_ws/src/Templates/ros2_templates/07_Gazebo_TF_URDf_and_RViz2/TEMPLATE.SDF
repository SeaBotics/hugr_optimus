<?xml version="1.0" ?>
<!-- The root element is always <sdf> specifying the format version -->
<sdf version="1.9">
  
  <!-- A model defines a physical object, robot, or structural asset -->
  <model name="pedagogical_sdf_robot">
    
    <!-- Poses in SDF are unified: [X Y Z Roll Pitch Yaw] -->
    <!-- This sets the default spawn position of the model in the world frame -->
    <pose>0 0 0.1 0 0 0</pose>

    <!-- ==================================================================== -->
    <!-- 1. CHASSIS LINK                                                      -->
    <!-- ==================================================================== -->
    <link name="chassis">
      <!-- Local pose of the link relative to the model origin -->
      <pose>0 0 0 0 0 0</pose>

      <!-- Inertial properties required for Gazebo's physics solver -->
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.2</iyy>
          <iyz>0.0</iyz>
          <izz>0.3</izz>
        </inertia>
      </inertial>

      <!-- Collision properties define physical contact behavior -->
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.6 0.4 0.2</size> <!-- length(X), width(Y), height(Z) -->
          </box>
        </geometry>
        
        <!-- Surface properties (friction, bounce, contact constraints) -->
        <!-- These are natively supported in SDF (unlike URDF) -->
        <surface>
          <friction>
            <ode>
              <mu>0.5</mu>  <!-- Primary friction coefficient -->
              <mu2>0.5</mu2> <!-- Secondary friction coefficient -->
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Visual properties define how the robot renders in Gazebo/GUI -->
      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>0.6 0.4 0.2</size>
          </box>
        </geometry>
        <!-- Material properties define color/shading -->
        <material>
          <ambient>0.0 0.0 0.8 1.0</ambient>  <!-- Color when in shadow -->
          <diffuse>0.0 0.0 1.0 1.0</diffuse>  <!-- Color under direct light -->
          <specular>0.1 0.1 0.1 1.0</specular> <!-- Highlight reflections -->
        </material>
      </visual>
    </link>

    <!-- ==================================================================== -->
    <!-- 2. WHEEL JOINT                                                       -->
    <!-- Connects 'chassis' (parent) to 'left_wheel' (child)                 -->
    <!-- ==================================================================== -->
    <joint name="left_wheel_joint" type="revolute">
      <!-- In SDF, poses of joints are set relative to the child link frame -->
      <parent>chassis</parent>
      <child>left_wheel</child>
      
      <!-- Axis of rotation relative to the joint frame -->
      <axis>
        <xyz>0 1 0</xyz> <!-- Rotates around the Y-axis -->
        <limit>
          <!-- Since this is a continuous wheel, we set no upper/lower limits,
               or leave them out. For standard revolute joints, specify limits: -->
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>10.0</effort>   <!-- Max torque (Nm) -->
          <velocity>20.0</velocity> <!-- Max velocity (rad/s) -->
        </limit>
        <dynamics>
          <damping>0.1</damping>  <!-- Viscous damping coefficient -->
          <friction>0.05</friction> <!-- Joint static friction -->
        </dynamics>
      </axis>
    </joint>

    <!-- ==================================================================== -->
    <!-- 3. WHEEL LINK                                                        -->
    <!-- ==================================================================== -->
    <link name="left_wheel">
      <!-- Position the wheel: Shifted +0.2m forward (X), +0.25m left (Y) -->
      <pose>0.2 0.25 0 0 0 0</pose>
      
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.005</iyy>
          <iyz>0.0</iyz>
          <izz>0.008</izz>
        </inertia>
      </inertial>

      <collision name="left_wheel_collision">
        <!-- Cylinder axes in SDF always align along the Z-axis by default -->
        <!-- To orient the wheel, rotate the geometry or link pose -->
        <pose>0 0 0 1.5708 0 0</pose> <!-- Roll 90 degrees to align wheel -->
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu> <!-- High friction for driving wheels -->
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="left_wheel_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- ==================================================================== -->
    <!-- 4. GAZEBO SIMULATION PLUGINS & SENSORS                               -->
    <!-- Plugins and Sensors are declared natively as children of model/link -->
    <!-- ==================================================================== -->
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <!-- right_joint would go here -->
      <wheel_separation>0.5</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <topic>cmd_vel</topic>
    </plugin>

  </model>
</sdf>